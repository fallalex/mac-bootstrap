    intellij-idea-ce
    font-fira-code
    firefox
    google-chrome
    zoom
    slack
    mactex
    qbittorrent
    microsoft-remote-desktop
    alacritty
    neovide
    todoist
    maccy
)

/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"
# Run the command `brew tap` to see all taps in use
# Running the following will list packages available from a tap
#     brew tap-info vmware/tvs --json | jq -r '.[]|(.formula_names[],.cask_tokens[])'
/opt/homebrew/bin/brew tap homebrew/cask-fonts
/opt/homebrew/bin/brew tap showwin/speedtest
/opt/homebrew/bin/brew install ${packages[*]}
/opt/homebrew/bin/brew install --cask ${casks[*]}

